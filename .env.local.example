# Copiá este archivo a .env.local y completá los valores de tu proyecto Supabase
# (Settings > Data API y Settings > Database en el dashboard de supabase.com).

# --- Necesarias en Netlify (Site settings > Environment variables) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — reemplazó a la vieja "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Sólo para tu máquina — NO cargar en Netlify ---
# Connection string directa a Postgres (Settings > Database > Connection string > URI).
# Se usa sólo para correr `npm run migrate` desde tu máquina; la app deployada
# nunca la necesita (habla con Supabase por su API, no por conexión directa a
# la base) y tiene tu password de DB adentro — no hace falta exponerla.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
